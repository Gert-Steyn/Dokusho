<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--============-->
    <!-- Base Theme -->
    <!--============-->

    <!--== Theme Base ==-->
    <style name="Base.Theme.Tachiyomi" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disallow "Force dark theme" -->
        <item name="android:forceDarkAllowed" tools:targetApi="Q">false</item>

        <!-- Theme Colors -->
        <item name="colorPrimary">@color/graphite_accent_fill</item>
        <item name="colorOnPrimary">@color/graphite_on_accent</item>
        <item name="colorPrimaryContainer">@color/graphite_accent_subtle</item>
        <item name="colorOnPrimaryContainer">@color/graphite_accent</item>
        <item name="colorPrimaryInverse">@color/graphite_accent</item>
        <item name="colorSecondary">@color/graphite_accent_fill</item>
        <item name="colorOnSecondary">@color/graphite_on_accent</item>
        <item name="colorSecondaryContainer">@color/graphite_hover</item>
        <item name="colorOnSecondaryContainer">@color/graphite_text</item>
        <item name="colorTertiary">@color/graphite_accent_fill</item>
        <item name="colorOnTertiary">@color/graphite_on_accent</item>
        <item name="android:colorBackground">@color/graphite_canvas</item>
        <item name="colorOnBackground">@color/graphite_text</item>
        <item name="colorSurface">@color/graphite_canvas</item>
        <item name="colorOnSurface">@color/graphite_text</item>
        <item name="colorSurfaceVariant">@color/graphite_surface</item>
        <item name="colorOnSurfaceVariant">@color/graphite_text_secondary</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
        <item name="colorSurfaceInverse">@color/graphite_text</item>
        <item name="colorOnSurfaceInverse">@color/graphite_canvas</item>
        <item name="colorError">@color/graphite_danger</item>
        <item name="colorOnError">@color/graphite_on_danger</item>
        <item name="colorErrorContainer">@color/graphite_danger_subtle</item>
        <item name="colorOnErrorContainer">@color/graphite_danger</item>
        <item name="colorOutline">@color/graphite_border</item>
        <item name="colorOutlineVariant">@color/graphite_border_subtle</item>
        <item name="colorSurfaceContainer">@color/graphite_surface</item>
        <item name="colorSurfaceContainerHigh">@color/graphite_raised</item>
        <item name="colorSurfaceContainerHighest">@color/graphite_hover</item>
        <item name="colorSurfaceContainerLow">@color/graphite_surface</item>
        <item name="colorSurfaceContainerLowest">@color/graphite_canvas</item>

        <item name="android:divider">@color/divider_default</item>
        <item name="android:listDivider">@drawable/line_divider</item>
        <item name="materialDividerStyle">@style/Widget.Tachiyomi.MaterialDivider</item>

        <!-- Ripples -->
        <item name="colorControlHighlight">?attr/colorSurfaceVariant</item>

        <!-- Handles RTL Text -->
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>

        <!-- Themes -->
        <item name="android:windowLightStatusBar">@bool/lightStatusBar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/graphite_surface</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="o_mr1">@null</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="Q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="Q">false</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Widget.Menu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Tachiyomi.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tachiyomi.MaterialAlertDialog</item>
        <item name="textAppearanceButton">@style/TextAppearance.Widget.Button</item>
        <item name="android:buttonStyle">?attr/borderlessButtonStyle</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionOverflowButtonStyle">@style/Theme.Tachiyomi.ActionButton.Overflow</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="appBarLayoutStyle">@style/Widget.Material3.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar.Surface</item>
        <item name="switchStyle">@style/Widget.Tachiyomi.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
    </style>

    <style name="Theme.Tachiyomi" parent="Base.Theme.Tachiyomi" />

    <!--===============-->
    <!-- Launch Screen -->
    <!--===============-->

    <!--== Splash Theme ==-->
    <style name="Theme.Tachiyomi.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_background</item>
        <item name="windowSplashScreenBackground">@color/graphite_canvas</item>
        <item name="postSplashScreenTheme">@style/Theme.Tachiyomi</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
